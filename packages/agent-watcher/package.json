{
  "name": "@netizen-labs/agent-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Watches a Netizen relay for mentions of a node's agent and answers in place.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": { "netizen-agent-watcher": "src/cli.ts" },
  "exports": { ".": "./src/index.ts" },
  "files": ["src"],
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/agent-watcher.cjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@netizen-labs/nostr": "workspace:*" },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
