{
  "name": "@roebel/staging-participant-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Narrow, staging-only participant write gateway for the Röbel main feed.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "roebel-staging-participant-gateway": "dist/staging-participant-gateway.cjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "dist"],
  "scripts": {
    "start": "node dist/staging-participant-gateway.cjs",
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netizen-labs/nostr": "workspace:*",
    "@netizen-labs/relay-sync": "workspace:*"
  },
  "devDependencies": {
    "@netizen-labs/agent-watcher": "workspace:*",
    "@roebel/e2e-workbench": "workspace:*",
    "@types/node": "^22.7.4",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
