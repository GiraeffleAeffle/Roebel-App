{
  "name": "@netizen-labs/publisher",
  "version": "0.1.0",
  "private": true,
  "description": "Netizen public-data publisher — mirrors a node's public datasets (events, cinema, organisations) onto its Nostr relay as signed, replaceable events.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "netizen-publisher": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "publish-once": "tsx src/cli.ts --once",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/publisher.cjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netizen-labs/nostr": "workspace:*",
    "@netizen-labs/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
