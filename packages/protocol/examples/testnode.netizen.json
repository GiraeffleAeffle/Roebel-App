{
  "nsp": "0",
  "manifestVersion": "1.0.0",
  "id": "testnode",
  "name": "Netizen Test Node",
  "type": "community",
  "chain": {
    "chainId": 100,
    "rpc": "$GNOSIS_RPC"
  },
  "contracts": {
    "citizenNft": "0x59aA26f499D7C2B3EC2c8524Ed06F54fc4E85dE5",
    "attesterNft": "0xC587F383696D3c9DF7A6eE03A9160E40Ae1cdb82",
    "governor": "0x5F5e499Dc1872c2Ce19a4b50cd10f680e78E3Ba3",
    "timelock": "0x5b358A77E89FF3d699607b4fC235b381d67f3d05",
    "maci": "0x6663eDC8650276fe264710B1A2ba46eB8bd0bF1D",
    "safe": "0x3A08c86Efc5ff38CC35d850F1D4d564e497bFDEa",
    "gatekeeper": "0xc4B9E45F0e84BC0CDe930CE888E4D0e38184f277"
  },
  "identity": {
    "idp": {
      "issuer": "https://id.roebel.app",
      "discovery": "https://id.roebel.app/.well-known/openid-configuration",
      "hosted": "external",
      "jwks": "$ROEBEL_ID_JWKS",
      "authMethods": [
        "wallet-siwe",
        "google",
        "apple",
        "facebook",
        "email"
      ],
      "scopes": [
        "openid",
        "email",
        "profile",
        "roebel"
      ],
      "claims": [
        "sub",
        "email",
        "name",
        "picture",
        "groups",
        "roebel:citizen",
        "roebel:attester",
        "roebel:tier",
        "roebel:actor_type"
      ]
    },
    "authBridge": {
      "provider": "thirdweb",
      "chain": 100,
      "accountType": "erc4337-smart",
      "bundlerRpc": "$GNOSIS_BUNDLER_RPC"
    },
    "relyingParties": [
      {
        "id": "nextcloud",
        "redirectUris": [
          "https://cloud.roebel.app/apps/user_oidc/code"
        ],
        "scopes": [
          "openid",
          "email",
          "profile",
          "roebel"
        ]
      },
      {
        "id": "matrix",
        "redirectUris": [
          "https://auth.roebel.app/upstream/callback/01JBXR8QW3ZK7YFN2MHTVC4DS6"
        ],
        "scopes": [
          "openid",
          "email",
          "profile",
          "roebel"
        ]
      },
      {
        "id": "web",
        "redirectUris": [
          "https://www.roebel.app/api/auth/callback"
        ]
      },
      {
        "id": "expo",
        "redirectUris": [
          "roebelapp://auth"
        ]
      }
    ],
    "membership": {
      "credential": "CitizenNFTv2",
      "admission": {
        "attesterBand": "30%/floor2/cap7",
        "sybilTier": "in-person"
      },
      "portable": true,
      "exitable": true
    },
    "agentIdentity": {
      "grant": "client_credentials",
      "delegation": "rfc8693-act",
      "killSwitch": true
    },
    "federation": {
      "trustedIssuers": [],
      "registry": "CommunityRegistry@gnosis (deferred to node #2)"
    }
  },
  "governance": {
    "engine": "maci",
    "coordinator": {
      "type": "shamir",
      "threshold": "3-of-5",
      "pubkey": "$COORDINATOR_PUBKEY"
    }
  },
  "treasury": {
    "safe": "0x3A08c86Efc5ff38CC35d850F1D4d564e497bFDEa",
    "splits": {
      "reserve": 50,
      "ops": 30,
      "dividend": 20
    },
    "agentBudgets": [
      {
        "role": "newsroom",
        "cap": "50/mo",
        "token": "EURe"
      }
    ]
  },
  "services": {
    "host": {
      "provider": "hetzner",
      "region": "eu-central"
    },
    "chat": {
      "nostr": {
        "relay": "wss://relay2.roebel.app"
      }
    }
  },
  "peers": [
    {
      "id": "roebel",
      "name": "Röbel / Müritz",
      "relay": "ws://roebel-strfry-1:7777",
      "kinds": [
        0,
        1
      ],
      "why": "Genesis Node #1. This fixture mirrors Röbel's public record to prove NSP-9 federation in both directions."
    }
  ],
  "branding": {
    "primary": "#00498B",
    "logo": "/favicon.svg",
    "fonts": [
      "Inter",
      "Plus Jakarta Sans"
    ]
  },
  "modules": {
    "feed": true
  }
}