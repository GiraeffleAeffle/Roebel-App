{
  "name": "@netizen-labs/relay-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Netizen relay allow-list syncer — verifies wallet↔npub bindings + on-chain membership, then writes the relay's write-policy allow-list.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "netizen-relay-sync": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "sync": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/relay-sync.cjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netizen-labs/nostr": "workspace:*",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
