ISSUER_URL=https://id.roebel.app
PORT=3010
COOKIE_KEYS=change-me-1,change-me-2
GNOSIS_RPC_URL=https://rpc.gnosischain.com
CHAIN_ID=100
CITIZEN_NFT_ADDRESS=0x59aA26f499D7C2B3EC2c8524Ed06F54fc4E85dE5
ATTESTER_NFT_ADDRESS=0xC587F383696D3c9DF7A6eE03A9160E40Ae1cdb82
SUPABASE_URL=https://wwbeqhkslxdxhktqzqti.supabase.co
SUPABASE_SERVICE_KEY=__set_in_fly_secrets__
THIRDWEB_CLIENT_ID=__same_project_as_web_and_expo__
NEXTCLOUD_CLIENT_ID=nextcloud
NEXTCLOUD_CLIENT_SECRET=__set_in_fly_secrets__
NEXTCLOUD_REDIRECT_URIS=https://cloud.roebel.app/apps/user_oidc/code
# Matrix (MAS) — OPTIONAL second first-party client. Leave unset until Matrix is
# stood up; the keystone boots unchanged without it. See docs/WORKSPACE_SSO_SETUP.md.
# MATRIX_CLIENT_ID=matrix
# MATRIX_CLIENT_SECRET=__set_in_fly_secrets__
# MATRIX_REDIRECT_URIS=https://auth.roebel.app/upstream/callback/<mas-provider-ulid>
# The Röbel web app's workspace session (optional; omit to disable the workspace)
WEB_CLIENT_ID=roebel-web
WEB_CLIENT_SECRET=replace-with-a-strong-random-secret
WEB_REDIRECT_URIS=https://roebel.app/api/workspace/auth/callback
# Ortis (the multi-community consumer of this keystone) — OPTIONAL first-party client.
# Leave unset until the Ortis app is stood up; the keystone boots unchanged without it.
# Replace <domain> with the Ortis deployment's own domain; the second URI is for local
# Ortis dev against this keystone. See README.md "Environment variables".
# ORTIS_BRANDING defaults to ortis (pilot-critical: a visiting mayor must never see Röbel
# branding); the line below is shown for discoverability, not because it's required.
# ORTIS_CLIENT_ID=ortis
# ORTIS_CLIENT_SECRET=__set_in_fly_secrets__
# ORTIS_REDIRECT_URIS=https://app.ortis.<domain>/api/auth/callback,http://localhost:3000/api/auth/callback
# ORTIS_BRANDING=ortis
# ORTIS_BRANDING_CONTEXT=Amt Musterstadt
# Any other first-party RPs beyond Nextcloud/Matrix/Web/Ortis: comma-separated env-var
# prefixes, each then fully required (see README.md "Environment variables").
# FIRST_PARTY_RPS=BUZZ
JWKS_JSON=__paste_output_of_generate-jwks__
