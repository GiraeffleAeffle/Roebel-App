# Independent synthetic identity instance; never copy the production .env.
NODE_ENV=production
ROEBEL_ID_DEPLOYMENT_PROFILE=staging-synthetic
ISSUER_URL=https://roebel-id.staging.agentcart.eu
PORT=3010
COOKIE_KEYS=
JWKS_JSON=
GNOSIS_RPC_URL=https://rpc.gnosischain.com
CHAIN_ID=100
SUPABASE_URL=http://roebel-tracer-postgrest.stadtstack-roebel-staging-lab.svc.cluster.local:3000
# Restricted PostgREST role for oidc_payloads only; not a general service-role key.
STAGING_IDENTITY_DATABASE_KEY=
STAGING_ALLOWED_WALLETS=
WEB_CLIENT_ID=roebel-town-workspace-staging
WEB_CLIENT_SECRET=
WEB_REDIRECT_URIS=https://roebel-web.staging.agentcart.eu/api/workspace/auth/callback
