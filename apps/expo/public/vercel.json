{
  "rewrites": [{ "source": "/((?!_expo/|assets/|icons/|sw\\.js|manifest\\.json|offline\\.html).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
